variable "env" {
  type = string
}

variable "partner_a_role_arn" {
  description = "The partner's own role that will assume ours, e.g. arn:aws:iam::<THEIR_ACCOUNT>:role/their-app"
  type        = string
}

variable "partner_a_external_id" {
  description = "Generated by us, shared with partner A only"
  type        = string
  sensitive   = true
}
